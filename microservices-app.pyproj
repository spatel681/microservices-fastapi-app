<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>497d407b-dc3d-482a-a3d8-f7f3c9362251</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>
    </StartupFile>
    <SearchPath>
    </SearchPath>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <Name>microservices-app</Name>
    <RootNamespace>microservices-app</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="order-service\app.py" />
    <Compile Include="product-service\app.py" />
    <Compile Include="user-service\app.py" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="order-service\" />
    <Folder Include="product-service\" />
    <Folder Include="user-service\" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="docker-compose.yml" />
    <Content Include=".gitignore" />
    <Content Include="LICENSE" />
    <Content Include="order-service\Dockerfile" />
    <Content Include="order-service\requirements.txt" />
    <Content Include="product-service\Dockerfile" />
    <Content Include="product-service\requirements.txt" />
    <Content Include="README.md" />
    <Content Include="user-service\Dockerfile" />
    <Content Include="user-service\requirements.txt" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
  <!-- Uncomment the CoreCompile target to enable the Build command in
       Visual Studio and specify your pre- and post-build commands in
       the BeforeBuild and AfterBuild targets below. -->
  <!--<Target Name="CoreCompile" />-->
